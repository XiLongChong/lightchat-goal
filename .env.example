# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Server
HOST=127.0.0.1
PORT=8899

# Public /chat API
CHAT_AUTH_ENABLED=true
CHAT_API_KEY=
CHAT_API_KEY_ENV=CHAT_API_KEY

# EmoRebot bridge (for WeChat integration)
EMOREBOT_API_URL=http://localhost:3000/api
EMOREBOT_SHARED_SECRET=change-me

# Agent identity
AGENT_NAME=Yu
AGENT_PERSONA_SHORT=一个长期在微信聊天朋友

# Logging
LOG_LEVEL=INFO

# Phase 5A: Native tool calls gray-release (default false)
# Set to true to enable native function calling for get_time/get_weather
# Only use in local dev / test bot — never on production users
GOAL_NATIVE_TOOL_CALLS=false

# Local admin UI
ADMIN_PASSWORD=admin
