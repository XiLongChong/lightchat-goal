# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
MODEL_CONTEXT_WINDOW_TOKENS=1000000

# Server
HOST=127.0.0.1
PORT=8899

# Public /chat API
CHAT_AUTH_ENABLED=true
CHAT_API_KEY=
CHAT_API_KEY_ENV=CHAT_API_KEY

# EmoRebot bridge (for WeChat integration)
EMOREBOT_API_URL=http://localhost:3000/api
EMOREBOT_SHARED_SECRET=change-me

# Agent identity
AGENT_NAME=Yu
AGENT_PERSONA_SHORT=一个长期在微信聊天朋友

# Logging
LOG_LEVEL=INFO

# QWeather (和风天气) API credentials
# Sign up at https://dev.qweather.com/ — free tier supports real-time + 7-day forecast
# API Key auth for early development; JWT preferred for production (see docs)
QWEATHER_API_KEY=
# Optional: your unique API host (found in QWeather console settings)
# Defaults to api.qweather.com if not set
QWEATHER_API_HOST=

# Phase 5A: Native tool calls gray-release (default false)
# Set to true to enable native function calling for get_time/get_weather
# Only use in local dev / test bot — never on production users
GOAL_NATIVE_TOOL_CALLS=false

# Tavily Search API key (用于联网搜索工具)
TAVILY_API_KEY=your_tavily_api_key_here

# Microsoft To Do (Azure AD 应用注册)
MS_TODO_CLIENT_ID=your_azure_ad_client_id_here
MS_TODO_TENANT=common

# Local admin UI
ADMIN_PASSWORD=admin
